  "cards": [
    {
      "dot": "cyan",
      "title": "What the model decides",
      "items": [
        "Whether a receipt line and a notice describe the same object",
        "How to word the claim, citing the recall number",
        "Which single question to ask when evidence is missing"
      ]
    },
    {
      "dot": "rose",
      "title": "What it can never decide",
      "items": [
        "Whether the purchase date falls inside the sold window",
        "Whether the price falls inside the notice's band",
        "Whether a claim may be filed at all"
      ]
    },
    {
      "dot": "emerald",
      "title": "What survives the tab closing",
      "items": [
        "Cases keyed by a deterministic id, so a rerun never files twice",
        "An evidence pack a person can audit months later",
        "A daily run that nobody has to remember"
      ]
    }
